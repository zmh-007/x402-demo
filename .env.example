# ===== client =====
# Base Sepolia 测试网钱包私钥(需持有测试 USDC:https://faucet.circle.com)
EVM_PRIVATE_KEY=0x...
# 受 x402 保护的接口地址
ENDPOINT=http://localhost:3000/protected-route

# ===== server =====
# 收款钱包地址(和上面付款私钥对应的地址不要相同,否则自己付给自己看不出效果)
PAY_TO=0x...
# 验签 + 代付 gas 上链结算的 facilitator(默认支持 Base Sepolia)
FACILITATOR_URL=https://facilitator.x402.rs
PORT=3000
# 对外访问地址,写进 402 响应的 resource.url
BASE_URL=http://localhost:3000
